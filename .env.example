# Supabase プロジェクトの設定値
# Supabase ダッシュボード → Project Settings → API からコピーしてください。
# ローカル開発ではこのファイルを .env.local にコピーして値を埋めます。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Gemini API キー(商品パッケージの写真から商品名・内容量を読み取るのに使用)
# https://aistudio.google.com/apikey で無料発行できます。
# 未設定でもアプリは動きます(写真の読み取りだけが使えません)。
# サーバー専用シークレットのため NEXT_PUBLIC_ は絶対に付けないこと。
GEMINI_API_KEY=your-gemini-api-key

# 使用する Gemini のモデル名(任意)。
# 未設定なら lib/gemini.ts が使えるモデルを自動で選びます。
# モデルが提供終了になったときは、まず /api/gemini/health で
# 使えるモデルを確認し、必要ならここで固定してください。
# GEMINI_MODEL=gemini-3.6-flash
